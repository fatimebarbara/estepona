  const LANGS = ["en","fr","es","de"];
  function applyLang(code){
    const t = I18N[code] || I18N.en;
    document.documentElement.lang = code;
    if(t.title) document.title = t.title;
    document.querySelectorAll("[data-i18n]").forEach(function(el){
      var k = el.getAttribute("data-i18n"); if(t[k]!=null) el.textContent = t[k];
    });
    document.querySelectorAll("[data-i18n-html]").forEach(function(el){
      var k = el.getAttribute("data-i18n-html"); if(t[k]!=null) el.innerHTML = t[k];
    });
    document.querySelectorAll(".langs button").forEach(function(b){
      b.classList.toggle("active", b.dataset.lang===code);
    });
    try{ localStorage.setItem("penthouse_mkt_lang", code); }catch(e){}
  }
  function initLang(){
    var code = "en";
    try{ var s = localStorage.getItem("penthouse_mkt_lang"); if(s && LANGS.indexOf(s)>-1) code = s; }catch(e){}
    if(code==="en"){ var b=(navigator.language||"").slice(0,2).toLowerCase(); if(LANGS.indexOf(b)>-1) code=b; }
    document.querySelectorAll(".langs button").forEach(function(b){
      b.addEventListener("click", function(){ applyLang(b.dataset.lang); });
    });
    applyLang(code);
  }
  document.addEventListener("DOMContentLoaded", initLang);
</script>
